server {
    listen 80;
    # The image's 10-listen-on-ipv6-by-default.sh only patches the *packaged*
    # default.conf; it skips ours ("differs from the packaged version"), so IPv6
    # has to be declared here. Without it `localhost` (which resolves to ::1
    # first) is refused inside the container — which is what made the healthcheck
    # fail and, in turn, held back cloudflared's depends_on.
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Behind the Cloudflare tunnel nginx always sees plain http, so the
    # visitor's real scheme arrives in X-Forwarded-Proto. If a proxied request
    # came in over http, redirect: without HTTPS the browser withholds
    # crypto.subtle and keycloak-js fails with "Web Crypto API is not
    # available".
    #
    # Deliberately keyed on the header being *present and http* — a direct
    # request to the loopback publish has no X-Forwarded-Proto and is left
    # alone, since localhost is already a secure context.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # Single page app.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The silent-SSO callback is loaded INSIDE a same-origin iframe, so it is
    # the one page that must be framable. The server-level
    # `frame-ancestors 'none'` + `X-Frame-Options: DENY` below refuse all
    # framing — including by this origin — which surfaces in DevTools as the
    # unhelpful "(blocked:other)".
    #
    # Scoped here rather than relaxed site-wide, so only this callback is
    # framable and only by us; the app keeps the strictest posture.
    #
    # nginx add_header inheritance is all-or-nothing: declaring any add_header
    # in a location drops every add_header from the server block, so the ones
    # we still want are repeated here.
    location = /silent-check-sso.html {
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; frame-ancestors 'self'; base-uri 'none'" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # It carries an authorization code in the query string — never cache it.
        add_header Cache-Control "no-store, must-revalidate" always;
        expires -1;
    }

    # Runtime configuration must never be cached, or a deploy-time URL change
    # would not reach browsers that already hold the old file.
    location = /config.js {
        add_header Cache-Control "no-store, must-revalidate";
        expires -1;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # §25 hardening.
    #
    # ${KEYCLOAK_ORIGIN} is substituted at container start (see the Dockerfile's
    # /etc/nginx/templates mechanism). It must be present in BOTH:
    #   connect-src — keycloak-js fetches the token and account endpoints;
    #   frame-src   — `check-sso` loads a hidden iframe pointed at Keycloak,
    #                 and Keycloak's prompt=none response REDIRECTS that iframe
    #                 back to /silent-check-sso.html on this origin. CSP is
    #                 enforced on the redirect target too, so 'self' is required
    #                 as well as the IdP — omitting it fails as
    #                 ERR_BLOCKED_BY_CSP reported against the auth URL.
    # With a bare `default-src 'self'` both are blocked and login fails, which
    # is not obvious from the symptom.
    #
    # 'unsafe-inline' is needed for style-src only, because of index.html's
    # pre-paint background block.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_ORIGIN}; frame-src 'self' ${KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_ORIGIN}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}
