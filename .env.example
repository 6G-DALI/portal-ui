# Build-time defaults for local development.
#
# In a deployed container prefer public/config.js (runtime configuration) —
# §27: Vite bakes VITE_* values into the bundle, so Compose `environment:`
# entries cannot change an already-built image.
#
# Leave a service URL unset to have the portal show it as "Planned" rather than
# rendering a link that fails.

# Shared 6G-DALI tool suite — the navbar links.
# These are the SAME variable names dataops-ui reads, so one .env configures
# both apps identically. An unset value drops that navbar link.
VITE_DALI_URL=https://6gdali.eu/
VITE_DATASPACE_URL=https://catalogue.dspace.sparkworks.net
VITE_DATAOPS_URL=http://localhost:3000
VITE_MLOPS_URL=

# Data space
VITE_REPO_API_URL=https://dspace.sparkworks.net
VITE_SEARCH_API_URL=https://search.dspace.sparkworks.net

# Pipelines
VITE_ORCHESTRATOR_URL=http://localhost:8000

# Interoperability
VITE_NORTHBOUND_API_URL=
VITE_EDC_CONNECTOR_URL=

# Platform
VITE_AUTH_URL=https://auth.dspace.sparkworks.net/auth

# Single sign-on — realm/host must match the other DALI front ends
VITE_KEYCLOAK_REALM=dspace
VITE_KEYCLOAK_CLIENT_ID=dali-portal

# ─── Deployment (docker-compose.yml) ────────────────────────────────────────
# Not read by the frontend bundle; consumed by docker compose.

# Cloudflare tunnel token, from Zero Trust → Networks → Tunnels → your tunnel.
# SECRET: keep it out of git (.env is gitignored) and out of shell history.
CLOUDFLARE_TUNNEL_TOKEN=

# Keycloak origin (scheme + host, no path). Substituted into the nginx CSP;
# must match the IdP the portal authenticates against or login is blocked.
KEYCLOAK_ORIGIN=https://auth.dspace.sparkworks.net
